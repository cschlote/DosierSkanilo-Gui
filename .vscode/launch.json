{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch DosierSkanilo GUI (no args)",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch DosierSkanilo GUI  (load local)",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui",
      "args": [
        "--json",
        "./.filescanner.json",
        "--load"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch DosierSkanilo GUI  (auto-load + duplicates + filter)",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui",
      "args": [
        "--json",
        "./.filescanner.json",
        "--load",
        "--duplicates",
        "--query",
        "sample"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch DosierSkanilo GUI Test Application (CodeLLDB)",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui-test-application",
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
