{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch DosierSkanilo GUI (CodeLLDB)",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch GUI: Auto-load Local Index",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui",
      "args": [
        "--json",
        "./.filescanner.json",
        "--load"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch GUI: Auto-load + Duplicates + Filter",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui",
      "args": [
        "--json",
        "./.filescanner.json",
        "--load",
        "--duplicates",
        "--query",
        "sample"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Launch build/bin/dosierskanilo-gui-test-application (CodeLLDB)",
      "program": "${workspaceFolder}/build/bin/dosierskanilo-gui-test-application",
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
