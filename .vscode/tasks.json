{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-host",
            "type": "shell",
            "command": "./scripts/build.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-docs",
            "type": "shell",
            "command": "./scripts/build-docs.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run-docs",
            "type": "shell",
            "command": "./scripts/build-docs.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "test-host",
            "type": "shell",
            "command": "./scripts/test.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "./scripts/clean.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build-all",
            "type": "shell",
            "command": "./scripts/build-all.sh",
            "group": /* ““ */{
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "open-ui:mainwindow",
            "type": "shell",
            "command": "glade",
            "args": [
                "source/ui/mainwindow.ui"
            ],
            "problemMatcher": []
        },
        {
            "label": "open-ui:detailpane",
            "type": "shell",
            "command": "glade",
            "args": [
                "source/ui/detailpane.ui"
            ],
            "problemMatcher": []
        },
        {
            "label": "open-ui:detailpreview",
            "type": "shell",
            "command": "glade",
            "args": [
                "source/ui/detailpreview.ui"
            ],
            "problemMatcher": []
        },
        {
            "label": "open-ui:documentpage",
            "type": "shell",
            "command": "glade",
            "args": [
                "source/ui/documentpage.ui"
            ],
            "problemMatcher": []
        },
        {
            "label": "open-ui:preferencesdialog",
            "type": "shell",
            "command": "glade",
            "args": [
                "source/ui/preferencesdialog.ui"
            ],
            "problemMatcher": []
        },
        {
            "label": "open-ui:all",
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "glade source/ui/*.ui"
            ],
            "problemMatcher": []
        },
        {
            "label": "rebuild",
            "dependsOn": [
                "clean",
                "build-all"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
